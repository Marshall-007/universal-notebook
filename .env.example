# Supabase backend configuration.
#
# Copy this file to `.env` and fill in the values from your own Supabase
# project (Project Settings -> API). These are read at BUILD time by Vite.
#
# If these are left unset, the app runs fully offline in "demo mode" and never
# contacts a backend — it will NOT silently use someone else's project.
#
# For CI release builds, set the same two values as repository secrets named
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY (see .github/workflows/).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
